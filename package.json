    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/rule-tester": "^8.59.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
