{
  "name": "@deniszhitnyakov/eslint-plugin-hbo",
  "version": "0.6.0",
  "description": "Opinionated ESLint rules — author's own conventions: blank-line discipline, error-handling, test file layout, naming hygiene.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript",
    "code-style",
    "testing"
  ],
  "author": "Denis Zhitnyakov <denis.zhitnyakov@gmail.com> (https://github.com/ztnkv)",
  "license": "MIT",
  "homepage": "https://github.com/ztnkv/eslint-plugin-hbo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztnkv/eslint-plugin-hbo.git"
  },
  "bugs": {
    "url": "https://github.com/ztnkv/eslint-plugin-hbo/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
